{
  "name": "oewer-tools",
  "version": "0.1.0",
  "private": true,
  "description": "OEWER Tools: free online tools and blog, built from a public Excel workbook.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "export": "tsx scripts/export-content.ts",
    "validate": "tsx scripts/validate-workbook.ts",
    "seed": "tsx scripts/create-seed-workbook.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  }
}
