{
  "name": "oewer-tools",
  "version": "0.1.0",
  "private": true,
  "description": "OEWER Tools: free online tools and blog, built from a public Excel workbook.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run export && next dev",
    "build": "npm run export && next build && tsx scripts/write-redirects.ts && tsx scripts/add-admin-csp.ts",
    "build:preview": "OEWER_PREVIEW_ALL_TOOLS=1 OEWER_PREVIEW_DRAFTS=1 npm run build",
    "export": "tsx scripts/export-content.ts",
    "check-build": "tsx scripts/check-build.ts",
    "validate": "tsx scripts/validate-workbook.ts",
    "seed": "tsx scripts/create-seed-workbook.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.0.0",
    "http-server": "^14.1.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "lucide-react": "^1.64.0",
    "next": "^16.4.3",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
