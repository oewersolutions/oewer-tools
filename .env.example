# Copy to .env for local development. Never commit real values.
# NEXT_PUBLIC_* values are visible in the browser: public data only.
# Do NOT put the admin GitHub token here; it is entered in the admin page at run time.

NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_BASE_PATH=

# Repository the admin page edits (public information)
NEXT_PUBLIC_GITHUB_REPO=owner/repo
NEXT_PUBLIC_GITHUB_BRANCH=main

# Hosted analytics (public site identifier only)
NEXT_PUBLIC_ANALYTICS_SITE_ID=
